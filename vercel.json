{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "if [ -d server/web ]; then W=server/web; else W=web; fi; rm -rf public && mkdir -p public && cp $W/study.html public/index.html && cp $W/study.css $W/study.js public/",
  "outputDirectory": "public",
  "functions": {
    "api/index.py": {
      "maxDuration": 120
    }
  },
  "rewrites": [
    {
      "source": "/study/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/static/(.*)",
      "destination": "/$1"
    },
    {
      "source": "/study",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}
